{
    // Parameters
    //Simulation
    n_simulations: 1000,
    max_iterations: 500,

    //Environmentters
    n_nodes: 40,
    n_potential_facilities: 32,
    n_brd_players: 5,
    max_iterations: 1000,
    seed: 66,
    convergence_threshold: 1e-5,
    demand_distribution: ["normal",20,5],
    weight_distribution: ["normal",5,1],

    //State observation
    compact_states: true, // Generalization of states
    num_boxes: 10, // How much generalization
    distribution: "normal",
    k_movement_memory: 3,

    //Regulatory agent
    agent_architecture: "q_learning_eligibility", //Options so far: q_learning, drunk, montecarlo
    learn_from_scratch: true,
    alpha: 0.15,    // Importance of new experiences
    gamma: 0.99,    // Importance of future rewards
    epsilon: 0.9,   // Exploration
    epsilon_decay_rate: 0.97,
    epsilon_min: 0.05,
    optimistic_value: 10,
    n: 2, // n-steps bootstrap
    reward_function_name: "iterations",
    plan: true,
    planning_time: 5,
    eligibility_lambda: 5
}