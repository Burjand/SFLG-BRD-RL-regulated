{
    //Simulation hyperparameters
    n_simulations: 250,
    max_iterations: 500,

    //Environment hyperparameters
    n_nodes: 100,
    n_potential_facilities: 80,
    n_brd_players: 10,
    max_iterations: 1000,
    seed: 66,    
    convergence_threshold: 1e-5,
    demand_distribution: ["normal",20,5],
    weight_distribution: ["normal",5,1],

    //Regulatory agent hyperparameters
    agent_architecture: "montecarlo", //Options so far: q_learning, drunk, montecarlo
    learn_from_scratch: true,
    alpha: 0.15,    // Importance of new experiences
    gamma: 0.99,    // Importance of future rewards
    epsilon: 0.5,   // Exploration
    epsilon_decay_rate: 0.995,
    epsilon_min: 0.05,
    optimistic_value: 10,
    n: 2, // n-steps bootstrap
    reward_function_name: "iterations",
    plan: true,
    planning_time: 5,
}